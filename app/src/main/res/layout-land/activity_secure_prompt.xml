<?xml version="1.0" encoding="utf-8"?>
<!--
  layout-land/activity_secure_prompt.xml — Landscape Split Security Prompt
  Left: Full-height Image Preview | Right: Metadata + Explanation + Action Buttons.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    android:padding="16dp"
    tools:context=".activities.SecurePromptActivity">

    <!-- ── Header Bar ────────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_prompt_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_prompt_shield"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Security Shield"
            android:src="@drawable/ic_shield_check" />

        <TextView
            android:id="@+id/tv_prompt_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/tv_prompt_shield"
            android:text="New Capture Detected"
            android:textColor="@color/ghostOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_prompt_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.46" />

    <!-- ── Left Image Preview ────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_card_preview"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_prompt_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_prompt_header">

        <ImageView
            android:id="@+id/iv_prompt_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Captured Image Preview"
            android:scaleType="fitCenter" />

    </RelativeLayout>

    <!-- ── Right Metadata Card ───────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_meta_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_preview"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_prompt_split"
        app:layout_constraintTop_toBottomOf="@id/layout_prompt_header">

        <TextView
            android:id="@+id/tv_prompt_doc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ghostOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Library Card (#052307094)" />

        <TextView
            android:id="@+id/tv_prompt_doc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_prompt_doc_title"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_doc_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="IDENTITY"
            android:textColor="@color/ghostPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_prompt_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_prompt_doc_type"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp"
            tools:text="Khulna University of Engineering &amp; Technology LIBRARY CARD..." />

    </RelativeLayout>

    <!-- ── Explanation Text ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_prompt_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start"
        android:lineSpacingMultiplier="1.2"
        android:text="Encrypt this capture into your secure vault and erase it from your public gallery?"
        android:textColor="@color/ghostOnSurfaceMuted"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/layout_prompt_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_prompt_split"
        app:layout_constraintTop_toBottomOf="@id/layout_meta_card"
        app:layout_constraintVertical_bias="0.3" />

    <!-- ── Bottom Action Buttons ─────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_prompt_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_prompt_split">

        <TextView
            android:id="@+id/btn_prompt_ignore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/view_button_spacer"
            android:background="@drawable/bg_status_badge"
            android:gravity="center"
            android:text="Keep in Gallery"
            android:textColor="@color/ghostOnSurface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_button_spacer"
            android:layout_width="10dp"
            android:layout_height="44dp"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/btn_prompt_secure"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/view_button_spacer"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="Secure to Vault"
            android:textColor="@color/ghostOnPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
