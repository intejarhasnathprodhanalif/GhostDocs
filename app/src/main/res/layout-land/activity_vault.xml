<?xml version="1.0" encoding="utf-8"?>
<!--
  layout-land/activity_vault.xml — Landscape Vault Dashboard
  Side-by-side Search + Category chips row and compact top chrome maximize
  vertical viewport height for the multi-column encrypted grid.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    tools:context=".activities.VaultActivity">

    <!-- ── 1. Compact Toolbar ─────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar_vault"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/tv_toolbar_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ghostdocs_logo"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/tv_toolbar_icon"
            android:text="@string/app_name"
            android:textColor="@color/ghostOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_sign_out"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Sign out"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_logout" />

        <ImageView
            android:id="@+id/btn_open_settings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_sign_out"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/btn_import_photos"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_open_settings"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Import old photos"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_import" />

        <ImageView
            android:id="@+id/btn_open_profile"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_import_photos"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="User profile"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_person" />

    </RelativeLayout>

    <!-- ── 2. Compact Stats Bar ──────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_stats"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:background="@color/ghostSurfaceVariant"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_vault">

        <TextView
            android:id="@+id/tv_doc_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ghostOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="12 documents secured" />

        <TextView
            android:id="@+id/tv_watcher_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Watcher: ON"
            tools:textColor="@color/ghostSuccess" />

    </RelativeLayout>

    <!-- ── 3 & 4. Side-by-Side Search + Category Chips Row ───────────────── -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_search_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.38" />

    <RelativeLayout
        android:id="@+id/layout_search"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/ghostSurface"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingVertical="5dp"
        app:layout_constraintEnd_toStartOf="@id/guideline_search_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pill_search"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/tv_search_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/et_search_vault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:layout_toEndOf="@id/tv_search_icon"
                android:layout_toStartOf="@+id/btn_clear_search"
                android:background="@null"
                android:hint="Search vault..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ghostOnSurface"
                android:textColorHint="@color/ghostOnSurfaceMuted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_clear_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textColor="@color/ghostOnSurfaceMuted"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </RelativeLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout_categories"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/ghostSurface"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_search_split"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_chips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            tools:listitem="@layout/item_category_chip" />

    </RelativeLayout>

    <!-- ── 5. Main Multi-Column Vault RecyclerView ───────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vault"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/grid_layout_animation"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:itemCount="6"
        tools:listitem="@layout/item_document" />

    <!-- ── 6. Compact Horizontal Empty State ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Secure Vault is Empty"
            android:textColor="@color/ghostOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="The background Watcher automatically intercepts and hardware-encrypts sensitive screenshots."
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_import"
            style="@style/Button.GhostDocs.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="20dp"
            android:text="Secure Photos &amp; PDFs"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── 7. Floating Action Button ─────────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_watcher_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Toggle watcher"
        android:src="@android:drawable/ic_media_play"
        app:backgroundTint="@color/ghostPrimary"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/ghostOnPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>
