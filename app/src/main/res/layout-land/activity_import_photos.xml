<?xml version="1.0" encoding="utf-8"?>
<!--
  layout-land/activity_import_photos.xml — Landscape Batch Scan & Secure UI
  Compact combined top controls, 5-column photo grid, and horizontal bottom bar.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg">

    <!-- ── 1. Compact Toolbar ────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar_import"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back_import"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/ghostPrimary"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/btn_back_import"
            android:text="Secure Photos &amp; PDFs"
            android:textColor="@color/ghostOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Inline Selection Controls inside Toolbar Right Side -->
        <LinearLayout
            android:id="@+id/layout_quick_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_browse_gallery"
                style="@style/Button.GhostDocs.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Photos"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_browse_pdf"
                style="@style/Button.GhostDocs.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="PDFs"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rescan_device"
                style="@style/Button.GhostDocs.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="Rescan"
                android:textSize="12sp" />

        </LinearLayout>

    </RelativeLayout>

    <!-- ── Watcher Intelligence Suggestion Banner ────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_watcher_suggestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ghostSurfaceVariant"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_import"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_watcher_suggestion_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@+id/btn_select_suggested"
            android:text="Watcher Active: Sensitive photos suggested to secure."
            android:textColor="@color/ghostWarning"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_select_suggested"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Pick Suggested"
            android:textColor="@color/ghostPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- ── 3. Compact Selection Bar ──────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_selection_bar"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_watcher_suggestion">

        <CheckBox
            android:id="@+id/cb_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:buttonTint="@color/ghostPrimary"
            android:text="Select All"
            android:textColor="@color/ghostOnSurface"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="@color/ghostPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="0 of 14 selected" />

    </RelativeLayout>

    <!-- ── 4. Multi-Column Photo Grid ────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_gallery_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/grid_layout_animation"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_selection_bar"
        tools:listitem="@layout/item_gallery_photo" />

    <!-- ── Empty State ───────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layout_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_selection_bar">

        <TextView
            android:id="@+id/tv_empty_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_brand_circle"
            android:gravity="center"
            android:text="GD"
            android:textColor="@color/ghostPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_empty_icon"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text="No Unvaulted Screenshots Detected"
            android:textColor="@color/ghostOnSurface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_empty_headline"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Tap 'Photos' or 'PDFs' above to manually pick files."
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp" />

    </RelativeLayout>

    <!-- ── 5. Single-Row Horizontal Bottom Action Bar ────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <CheckBox
            android:id="@+id/cb_delete_originals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/btn_secure_selected"
            android:buttonTint="@color/ghostAccent"
            android:checked="true"
            android:text="Delete originals from gallery after securing"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_secure_selected"
            style="@style/Button.GhostDocs.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:enabled="false"
            android:paddingHorizontal="20dp"
            android:text="Secure Selected (0)"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- ── 6. Full Screen Progress Overlay ───────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_progress_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D9000000"
        android:clickable="true"
        android:elevation="25dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingHorizontal="80dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.GhostDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/ghostPrimary"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <ProgressBar
                    android:id="@+id/pb_progress_spinner"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:indeterminateTint="@color/ghostPrimary" />

                <TextView
                    android:id="@+id/tv_progress_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/pb_progress_spinner"
                    android:text="Securing Old Photos..."
                    android:textColor="@color/ghostOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_progress_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_progress_headline"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_toEndOf="@id/pb_progress_spinner"
                    android:text="Processing 1 of 5..."
                    android:textColor="@color/ghostPrimary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/pb_determinate_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_below="@id/pb_progress_spinner"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/ghostPrimary" />

                <TextView
                    android:id="@+id/tv_progress_filename"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/pb_determinate_bar"
                    android:layout_marginTop="8dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="Screenshot_2024.png"
                    android:textColor="@color/ghostOnSurfaceMuted"
                    android:textSize="11sp" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

