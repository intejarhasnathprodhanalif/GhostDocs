<?xml version="1.0" encoding="utf-8"?>
<!--
  widget_vault.xml — Home Screen Widget Layout
  Uses RelativeLayout as required by the spec.
  RemoteViews only supports a subset of views; we use:
    - RelativeLayout (root)
    - TextView (document count, watcher status, label)
    - Button (open vault)
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widgetBackground"
    android:padding="12dp">

    <!-- App name label -->
    <TextView
        android:id="@+id/tv_widget_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="@string/app_name"
        android:textColor="@color/ghostPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Document count -->
    <TextView
        android:id="@+id/tv_widget_doc_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_widget_app_name"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:text="-- docs secured"
        android:textColor="@color/widgetText"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Watcher status indicator -->
    <TextView
        android:id="@+id/tv_widget_watcher_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_widget_doc_count"
        android:layout_alignParentStart="true"
        android:layout_marginTop="2dp"
        android:text="@string/widget_watcher_off"
        android:textColor="@color/widgetSubtext"
        android:textSize="10sp" />

    <!-- Open Vault button -->
    <TextView
        android:id="@+id/btn_widget_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@null"
        android:padding="8dp"
        android:text="@string/widget_open"
        android:textColor="@color/ghostPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

</RelativeLayout>

