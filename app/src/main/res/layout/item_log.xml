<?xml version="1.0" encoding="utf-8"?>
<!--
  item_log.xml — Settings / Log ListView Row
  Single item for the LogListAdapter driving the SettingsActivity ListView.
  Uses RelativeLayout as required by spec.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="56dp"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- Divider at bottom -->
    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/ghostDivider" />

    <!-- Settings option label -->
    <TextView
        android:id="@+id/tv_log_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/tv_log_value"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:textColor="@color/ghostOnSurface"
        android:textSize="14sp" />

    <!-- Current value / navigation arrow -->
    <TextView
        android:id="@+id/tv_log_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:textColor="@color/ghostPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

</RelativeLayout>

