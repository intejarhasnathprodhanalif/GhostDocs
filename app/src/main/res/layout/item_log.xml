<?xml version="1.0" encoding="utf-8"?>
<!--
  item_log.xml — Polished Settings / Log ListView Row
  Single item for the LogListAdapter driving the SettingsActivity ListView.
  Uses RelativeLayout as mandated by spec.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="60dp"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp">

    <!-- Subtle Divider at bottom -->
    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/ghostDivider" />

    <!-- Settings Option Label -->
    <TextView
        android:id="@+id/tv_log_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:layout_toStartOf="@id/tv_log_value"
        android:textColor="@color/ghostOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="🌓 App Theme" />

    <!-- Current Value / Capsule Badge / Navigation Arrow -->
    <TextView
        android:id="@+id/tv_log_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_status_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/ghostPrimary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Dark Mode" />

</RelativeLayout>
