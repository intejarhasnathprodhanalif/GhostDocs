<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_secure_prompt.xml — Interactive Security Confirmation Screen
  Uses ConstraintLayout and RelativeLayout strictly conforming to the UI specification.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    android:padding="20dp"
    tools:context=".activities.SecurePromptActivity">

    <!-- ── Header Bar ────────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_prompt_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/tv_prompt_shield"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Security Shield"
            android:src="@drawable/ic_shield_check" />

        <TextView
            android:id="@+id/tv_prompt_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tv_prompt_shield"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:text="New Capture Detected"
            android:textColor="@color/ghostOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- ── Image Preview Container ───────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_preview"
        android:padding="8dp"
        app:layout_constraintDimensionRatio="4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_prompt_header">

        <ImageView
            android:id="@+id/iv_prompt_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Captured Image Preview"
            android:scaleType="fitCenter" />

    </RelativeLayout>

    <!-- ── Metadata Card ─────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_meta_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_preview"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_preview_container">

        <TextView
            android:id="@+id/tv_prompt_doc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ghostOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="bKash Receipt (Trx 9X92K7A)" />

        <TextView
            android:id="@+id/tv_prompt_doc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_prompt_doc_title"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_doc_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="RECEIPT"
            android:textColor="@color/ghostPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_prompt_snippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_prompt_doc_type"
            android:layout_marginTop="10dp"
            android:maxLines="3"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.15"
            tools:text="Payment of ৳1,500 completed to Merchant. TrxID: 9X92K7A..." />

    </RelativeLayout>

    <!-- ── Explanation Text ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_prompt_question"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Would you like to encrypt this capture into your secure vault and erase it from your public gallery?"
        android:textColor="@color/ghostOnSurfaceMuted"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_meta_card" />

    <!-- ── Action Buttons ────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_prompt_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btn_prompt_ignore"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/view_button_spacer"
            android:background="@drawable/bg_status_badge"
            android:gravity="center"
            android:text="Keep in Gallery"
            android:textColor="@color/ghostOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_button_spacer"
            android:layout_width="12dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true" />

        <TextView
            android:id="@+id/btn_prompt_secure"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/view_button_spacer"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:text="Secure to Vault"
            android:textColor="@color/ghostOnPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
