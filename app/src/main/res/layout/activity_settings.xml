<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_settings.xml — Settings & Log Screen
  Uses ConstraintLayout (as required by spec).
  Contains: toolbar, ListView (powered by LogListAdapter).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    tools:context=".activities.SettingsActivity">

    <!-- ── Custom Toolbar ────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar_settings"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back arrow -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:text="←"
            android:textColor="@color/ghostPrimary"
            android:textSize="22sp"
            android:contentDescription="Go back" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/settings_title"
            android:textColor="@color/ghostOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- ── Settings ListView ─────────────────────────────────────────────── -->
    <ListView
        android:id="@+id/lv_settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_settings" />

</androidx.constraintlayout.widget.ConstraintLayout>
