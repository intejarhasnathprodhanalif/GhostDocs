<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_vault.xml — Polished Secure Vault Dashboard
  Root: ConstraintLayout (as mandated by spec).
  Sub-containers: RelativeLayout and LinearLayout for layout hierarchy.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    tools:context=".activities.VaultActivity">

    <!-- ── 1. Custom Polished Toolbar ────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar_vault"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ghost Emblem Icon -->
        <TextView
            android:id="@+id/tv_toolbar_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_brand_circle"
            android:gravity="center"
            android:text="GD"
            android:textColor="@color/ghostPrimary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- App Name & Subtitle Container -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/tv_toolbar_icon">

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ghostOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_toolbar_title"
                android:text="Encrypted Hardware Vault"
                android:textColor="@color/ghostOnSurfaceMuted"
                android:textSize="10sp" />
        </RelativeLayout>

        <!-- Sign-out Circular Button -->
        <ImageView
            android:id="@+id/btn_sign_out"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Sign out"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_logout" />

        <!-- Settings Circular Button -->
        <ImageView
            android:id="@+id/btn_open_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btn_sign_out"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_settings" />

        <!-- Import / Scan Old Photos Circular Button -->
        <ImageView
            android:id="@+id/btn_import_photos"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btn_open_settings"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Import old photos"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_import" />

        <!-- User Profile Circular Button -->
        <ImageView
            android:id="@+id/btn_open_profile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/btn_import_photos"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="User profile"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_person" />

    </RelativeLayout>

    <!-- ── 2. Sleek Dual-Pill Stats Bar ──────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_stats"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@color/ghostSurfaceVariant"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_vault">

        <!-- Document Count Pill -->
        <TextView
            android:id="@+id/tv_doc_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/ghostOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="12 documents secured" />

        <!-- Watcher Status Capsule Pill -->
        <TextView
            android:id="@+id/tv_watcher_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="● Watcher: ON"
            tools:textColor="@color/ghostSuccess" />

    </RelativeLayout>

    <!-- ── 3. Search & Filter Bar ────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_pill_search"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/tv_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/et_search_vault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_toEndOf="@id/tv_search_icon"
                android:layout_toStartOf="@+id/btn_clear_search"
                android:background="@null"
                android:hint="Search title, type, tags, or OCR content..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ghostOnSurface"
                android:textColorHint="@color/ghostOnSurfaceMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_clear_search"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_clear_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textColor="@color/ghostOnSurfaceMuted"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- ── 4. Category Filter Bar (Smart Folders) ─────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_categories"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/ghostSurface"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_search">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_chips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            tools:listitem="@layout/item_category_chip" />

    </RelativeLayout>

    <!-- ── 5. Main RecyclerView (Firestore-synced vault grid) ────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vault"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/grid_layout_animation"
        android:paddingHorizontal="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="84dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:itemCount="6"
        tools:listitem="@layout/item_document" />

    <!-- ── 6. Polished Empty State ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:visibility="visible">

        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_brand_circle"
            android:gravity="center"
            android:text="GD"
            android:textColor="@color/ghostPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Your Secure Vault is Empty"
            android:textColor="@color/ghostOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="32dp"
            android:text="The background Watcher will automatically intercept and hardware-encrypt sensitive screenshots."
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="13sp" />

        <!-- Quick Import Pre-existing Photos Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_import"
            style="@style/Button.GhostDocs.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp"
            android:text="Secure Photos &amp; PDFs"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── 7. Floating Action Button (Start / Stop Watcher) ───────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_watcher_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Toggle watcher"
        android:src="@android:drawable/ic_media_play"
        app:backgroundTint="@color/ghostPrimary"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/ghostOnPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>
