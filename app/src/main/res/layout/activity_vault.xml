<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_vault.xml — Main Secure Vault Dashboard
  Full Step 3 implementation.
  Root: ConstraintLayout (as required by spec).
  Contains: custom toolbar, stats bar, RecyclerView, FAB, empty state.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostDarkBg"
    tools:context=".activities.VaultActivity">

    <!-- ── Custom Toolbar ────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/toolbar_vault"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Ghost icon -->
        <TextView
            android:id="@+id/tv_toolbar_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="👻"
            android:textSize="22sp" />

        <!-- App name -->
        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/tv_toolbar_icon"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ghostOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Sign-out button -->
        <TextView
            android:id="@+id/btn_sign_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:text="⇥"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="20sp"
            android:contentDescription="Sign out" />

        <!-- Settings button -->
        <TextView
            android:id="@+id/btn_open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_sign_out"
            android:padding="8dp"
            android:text="⚙"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="20sp"
            android:contentDescription="Settings" />

        <!-- Import / Scan Old Photos button -->
        <TextView
            android:id="@+id/btn_import_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_open_settings"
            android:padding="8dp"
            android:text="📥"
            android:textColor="@color/ghostPrimary"
            android:textSize="20sp"
            android:contentDescription="Import old photos" />

        <!-- User Profile button -->
        <TextView
            android:id="@+id/btn_open_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btn_import_photos"
            android:padding="8dp"
            android:text="👤"
            android:textColor="@color/ghostPrimary"
            android:textSize="20sp"
            android:contentDescription="User profile" />

    </RelativeLayout>

    <!-- ── Stats Bar ──────────────────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_stats"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/ghostSurfaceVariant"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_vault">

        <!-- Document count -->
        <TextView
            android:id="@+id/tv_doc_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp"
            tools:text="12 documents secured" />

        <!-- Watcher status dot -->
        <TextView
            android:id="@+id/tv_watcher_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="● Watcher: ON"
            tools:textColor="@color/ghostSuccess" />

    </RelativeLayout>

    <!-- ── Search & Filter Bar ───────────────────────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ghostSurface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_stats">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@color/ghostSurfaceVariant"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tv_search_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:text="🔍"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_search_vault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/tv_search_icon"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search title, type, tags, or OCR content..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ghostOnSurface"
                android:textColorHint="@color/ghostOnSurfaceMuted"
                android:textSize="13sp" />
        </RelativeLayout>
    </RelativeLayout>

    <!-- ── Category Filter Bar (Smart Folders) ────────────────────────── -->
    <RelativeLayout
        android:id="@+id/layout_categories"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:background="@color/ghostSurface"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_search">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_chips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            tools:listitem="@layout/item_category_chip" />

    </RelativeLayout>

    <!-- ── Main RecyclerView (Firestore-synced vault grid) ───────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vault"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:paddingTop="8dp"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:itemCount="6"
        tools:listitem="@layout/item_document" />

    <!-- ── Empty state (shown when vault has no documents) ───────────────── -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_categories"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁"
            android:textSize="56sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/vault_empty_state"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:paddingHorizontal="40dp" />

        <!-- Quick Import Pre-existing Photos Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_import"
            style="@style/Button.GhostDocs.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="📥 Secure Old Gallery Photos"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── FAB: Start / Stop Watcher ─────────────────────────────────────── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_watcher_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Toggle watcher"
        android:src="@android:drawable/ic_media_play"
        app:backgroundTint="@color/ghostPrimary"
        app:tint="@color/ghostOnPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>