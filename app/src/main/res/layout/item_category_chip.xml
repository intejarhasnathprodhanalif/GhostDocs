<?xml version="1.0" encoding="utf-8"?>
<!--
  item_category_chip.xml — Category Filter Pill for Vault Dashboard
  Root: RelativeLayout (adhering strictly to project layout guidelines).
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_chip_unselected"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/tv_chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:singleLine="true"
        android:textColor="@color/ghostOnSurfaceMuted"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="💳 Financial (4)" />

</RelativeLayout>

