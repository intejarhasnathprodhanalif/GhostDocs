<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_qr_share.xml — Air-Gapped QR Transfer Dialog
  Uses RelativeLayout strictly conforming to the XML layout specification.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ghostSurface"
    android:padding="24dp">

    <!-- Header: Title and Type -->
    <TextView
        android:id="@+id/tv_qr_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="Air-Gapped Vault Share"
        android:textColor="@color/ghostOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_qr_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_qr_title"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:background="@color/ghostDivider"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="RECEIPT"
        android:textColor="@color/ghostPrimary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Mode Toggle Row: Cloud Link vs Air-Gapped Card -->
    <RelativeLayout
        android:id="@+id/layout_qr_modes"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_below="@id/tv_qr_type"
        android:layout_marginTop="14dp"
        android:background="@color/ghostSurfaceVariant">

        <TextView
            android:id="@+id/btn_mode_cloud"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/view_mode_divider"
            android:gravity="center"
            android:text="🌐 Cloud Picture (Browser)"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/view_mode_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@color/ghostDivider" />

        <TextView
            android:id="@+id/btn_mode_airgap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/view_mode_divider"
            android:gravity="center"
            android:text="📱 Air-Gapped Card"
            android:textColor="@color/ghostPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Center QR Code View Container -->
    <RelativeLayout
        android:id="@+id/container_qr"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_below="@id/layout_qr_modes"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_preview"
        android:padding="14dp">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_qr_code"
            android:scaleType="fitCenter" />

        <ProgressBar
            android:id="@+id/pb_qr_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/ghostPrimary" />

    </RelativeLayout>

    <!-- Subtitle Explanation -->
    <TextView
        android:id="@+id/tv_qr_instructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/container_qr"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="🌐 Cloud Picture: Scan with any camera to view the picture in their browser!"
        android:textColor="@color/ghostOnSurfaceMuted"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.2" />

    <!-- Actions Row -->
    <RelativeLayout
        android:id="@+id/layout_qr_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_qr_instructions"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btn_qr_copy_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_card_preview"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="📋 Copy Link"
            android:textColor="@color/ghostPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_qr_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_chip_selected"
            android:paddingHorizontal="28dp"
            android:paddingVertical="10dp"
            android:text="Close"
            android:textColor="@color/ghostOnPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>

