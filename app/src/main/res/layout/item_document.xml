<?xml version="1.0" encoding="utf-8"?>
<!--
  item_document.xml — Vault Grid Card
  Single document card for the RecyclerView grid.
  Uses RelativeLayout (as required by spec) inside a MaterialCardView.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card.GhostDocs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="110dp">

        <!-- Left colour strip — type badge (colour set dynamically in adapter) -->
        <View
            android:id="@+id/view_type_badge"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:background="@color/ghostPrimary" />

        <!-- Ghost lock icon (placeholder until real thumbnail in Step 7) -->
        <TextView
            android:id="@+id/tv_doc_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_toEndOf="@id/view_type_badge"
            android:background="@color/ghostSurfaceVariant"
            android:gravity="center"
            android:text="🔐"
            android:textSize="20sp" />

        <!-- Document type badge label -->
        <TextView
            android:id="@+id/tv_doc_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_toEndOf="@id/tv_doc_icon"
            android:layout_toStartOf="@id/tv_doc_date"
            android:background="@color/ghostDivider"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/ghostPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Document date (top-right) -->
        <TextView
            android:id="@+id/tv_doc_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="14dp"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="10sp"
            android:maxLines="1" />

        <!-- Document title (main text) -->
        <TextView
            android:id="@+id/tv_doc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_doc_type"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="8dp"
            android:layout_toEndOf="@id/view_type_badge"
            android:textColor="@color/ghostOnSurface"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Primary tag chip -->
        <TextView
            android:id="@+id/tv_doc_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_doc_title"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:layout_toEndOf="@id/view_type_badge"
            android:background="@color/ghostDivider"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>

