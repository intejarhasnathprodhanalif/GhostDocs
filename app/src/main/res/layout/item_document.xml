<?xml version="1.0" encoding="utf-8"?>
<!--
  item_document.xml — Polished Vault Grid Card
  Root: MaterialCardView wrapping RelativeLayout.
  Complies strictly with OOP UI requirements: uses RelativeLayout inside CardView.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.GhostDocs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/ghostDivider"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:paddingBottom="12dp">

        <!-- Top dynamic colour accent strip (set by adapter at runtime) -->
        <View
            android:id="@+id/view_type_badge"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_alignParentTop="true"
            android:background="@color/ghostPrimary" />

        <!-- Header container: Icon, Type Badge & Date -->
        <RelativeLayout
            android:id="@+id/layout_card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/view_type_badge"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="12dp">

            <!-- Document Category Icon box -->
            <TextView
                android:id="@+id/tv_doc_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_card_preview"
                android:gravity="center"
                android:text="🔐"
                android:textSize="18sp" />

            <!-- Document Type Capsule Badge -->
            <TextView
                android:id="@+id/tv_doc_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_doc_icon"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@id/tv_doc_date"
                android:background="@drawable/bg_doc_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/ghostPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="FINANCIAL" />

            <!-- Document Date -->
            <TextView
                android:id="@+id/tv_doc_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:textColor="@color/ghostOnSurfaceMuted"
                android:textSize="10sp"
                android:maxLines="1"
                tools:text="Nov 08" />

        </RelativeLayout>

        <!-- Document Title -->
        <TextView
            android:id="@+id/tv_doc_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_card_header"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="12dp"
            android:textColor="@color/ghostOnSurface"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            tools:text="Bkash Cash In Receipt 2024" />

        <!-- Footer: Primary Tag Chip -->
        <TextView
            android:id="@+id/tv_doc_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_doc_title"
            android:layout_alignParentStart="true"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/ghostOnSurfaceMuted"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="🏷️ TrxID" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
