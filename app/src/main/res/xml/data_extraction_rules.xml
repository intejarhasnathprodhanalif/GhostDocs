<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml
  Explicitly disables cloud backup for GhostDocs.
  Encrypted vault files must NEVER leave the device via
  Android's auto-backup mechanism — only via our
  Firebase sync (which is authenticated and encrypted).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

